// Reverse Hunter v2.3 XAUUSD, ASIA ONLY -- TradingView STRATEGY version of
// XAUUSD_ReverseHunter_Asia_v23.mq5 (Asia session at 03:00 MT5 server time,
// 40-minute range, target 1.5 x width), with the Strategy Tester report.
//
// The session (MT5 server time = New York + 7h):
//   range     = high / low of the first rangeMin minutes after the start,
//   breakout  = first bar close beyond the range within boWin minutes,
//   reversal  = a stop order at the breakout's stop level (the far side of
//               the range), live until rvWin minutes after the range or
//               until the breakout reaches its own target (rr x width):
//               SL at the other side of the range, TP rr x width beyond,
//   flatten   = holdMin minutes after the range.
// Size: riskPct % of equity per trade (units = ounces), capped at maxUnits.
// Commission 0.1 per ounce per side stands in for the spread.
//@version=5
strategy("Reverse Hunter Azia v2.3 XAUUSD (strategji)", shorttitle="RH Azia", overlay=true,
     initial_capital=100000, currency=currency.USD, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.1,
     pyramiding=0, max_boxes_count=500, max_labels_count=500)

// ===== Inputs =====
grpS     = "Seanca (ora e serverit MT5 = New York + 7)"
asHour   = input.int(3, "Azia: ora", minval=0, maxval=23, inline="as", group=grpS)
asMin    = input.int(0, "min", minval=0, maxval=59, inline="as", group=grpS)

grpR     = "Rregullat (si në robot)"
rangeMin = input.int(40, "Range (minuta)", minval=5, group=grpR)
boWin    = input.int(90, "Thyerja lejohet deri në (minuta pas range-it)", minval=5, group=grpR)
rvWin    = input.int(180, "Kthimi lejohet deri në (minuta pas range-it)", minval=5, group=grpR)
holdMin  = input.int(360, "Mbyll pas (minuta pas range-it)", minval=10, group=grpR)
rr       = input.float(1.5, "TP (x gjerësia e range-it)", minval=0.5, step=0.5, group=grpR)
minStop  = input.float(0.10, "Kalo stop-et nën këtë % të çmimit", minval=0.0, step=0.01, group=grpR)

grpK     = "Rreziku"
riskPct  = input.float(0.5, "Rreziku për trade (% e llogarisë)", minval=0.1, step=0.1, group=grpK)
maxUnits = input.float(300, "Maksimumi i sasisë (ons; 100 ons = 1 lot)", minval=1, group=grpK)
showRange = input.bool(true, "Vizato range-in", group=grpK)

// ===== Types =====
type Sess
    string name
    int    startMin
    int    state = 0     // 1 range, 2 wait breakout, 3 reversal order waiting, 4 in position, 5 done
    float  hi
    float  lo
    int    bar0
    int    vDir
    float  vTP

// ===== Functions =====
f_step(Sess s, int srvMin) =>
    int  rEnd    = s.startMin + rangeMin
    bool inRange = srvMin >= s.startMin and srvMin < rEnd
    bool live    = srvMin >= rEnd and srvMin < rEnd + holdMin
    // outside the session nothing stays open or pending
    if not inRange and not live and (s.state == 3 or s.state == 4)
        strategy.cancel(s.name)
        strategy.cancel(s.name + " x")
        strategy.close(s.name, comment="Koha")
        s.state := 5
    if inRange
        if s.state != 1
            s.state := 1
            s.hi    := high
            s.lo    := low
            s.bar0  := bar_index
        else
            s.hi := math.max(s.hi, high)
            s.lo := math.min(s.lo, low)
    else if live
        int   e = srvMin - rEnd
        float w = s.hi - s.lo
        if s.state == 1
            s.state := 2
            if showRange
                box.new(s.bar0, s.hi, bar_index - 1, s.lo, border_color=color.new(color.gray, 40), bgcolor=color.new(color.gray, 85))
                label.new(s.bar0, s.hi, s.name, style=label.style_label_down, color=color.new(color.gray, 30), textcolor=color.white, size=size.small)
        if s.state == 2
            if e >= boWin or w <= 0
                s.state := 5
            else if close > s.hi or close < s.lo
                int vDir = close > s.hi ? 1 : -1
                s.vDir := vDir
                s.vTP  := vDir == 1 ? s.hi + rr * w : s.lo - rr * w
                float units = math.min(maxUnits, math.floor(strategy.equity * riskPct / 100 / w))
                if w / close * 100 >= minStop and units >= 1
                    int   dir   = -vDir
                    float entry = vDir == 1 ? s.lo : s.hi          // the breakout's stop level
                    float sl    = dir == 1 ? s.lo : s.hi
                    float tp    = dir == 1 ? s.hi + rr * w : s.lo - rr * w
                    strategy.entry(s.name, dir == 1 ? strategy.long : strategy.short, qty=units, stop=entry)
                    strategy.exit(s.name + " x", from_entry=s.name, stop=sl, limit=tp)
                    s.state := 3
                else
                    s.state := 5
        else if s.state == 3
            if strategy.position_size != 0
                s.state := 4
            else
                bool target = s.vDir == 1 ? high >= s.vTP : low <= s.vTP
                if target or e >= rvWin
                    strategy.cancel(s.name)
                    strategy.cancel(s.name + " x")
                    s.state := 5
        else if s.state == 4
            if strategy.position_size == 0
                s.state := 5
    true

// ===== State =====
var Sess asia = Sess.new("Azia", asHour * 60 + asMin)

int srvMin = ((hour(time, "America/New_York") + 7) % 24) * 60 + minute(time, "America/New_York")
f_step(asia, srvMin)

// ===== Results table =====
var table tb = table.new(position.top_right, 2, 7, bgcolor=color.rgb(20, 20, 20), border_width=1)
if barstate.islast
    int   wins = 0
    int   nTr = strategy.closedtrades
    if nTr > 0
        for i = 0 to nTr - 1
            wins += strategy.closedtrades.profit(i) > 0 ? 1 : 0
    float cap = strategy.initial_capital
    table.cell(tb, 0, 0, "Reverse Hunter Azia v2.3", text_color=color.white)
    table.cell(tb, 1, 0, timeframe.in_seconds() > 300 ? "Përdor 1m ose 5m!" : "", text_color=color.orange)
    table.cell(tb, 0, 1, "Trade", text_color=color.white)
    table.cell(tb, 1, 1, str.tostring(nTr), text_color=color.white)
    table.cell(tb, 0, 2, "Fitojnë", text_color=color.white)
    table.cell(tb, 1, 2, nTr > 0 ? str.tostring(100.0 * wins / nTr, "0") + "%" : "-", text_color=color.white)
    table.cell(tb, 0, 3, "Fitimi neto", text_color=color.white)
    table.cell(tb, 1, 3, str.tostring(strategy.netprofit, "#,##0") + " $ (" + str.tostring(100 * strategy.netprofit / cap, "0.0") + "%)", text_color=strategy.netprofit >= 0 ? color.lime : color.rgb(255, 90, 90))
    table.cell(tb, 0, 4, "Rënia më e madhe", text_color=color.white)
    table.cell(tb, 1, 4, str.tostring(strategy.max_drawdown, "#,##0") + " $", text_color=color.white)
    table.cell(tb, 0, 5, "Rreziku për trade", text_color=color.white)
    table.cell(tb, 1, 5, str.tostring(riskPct, "0.0#") + "%", text_color=color.white)
    table.cell(tb, 0, 6, "Skaneri 2020-2026", text_color=color.gray)
    table.cell(tb, 1, 6, "+62%, 55% fitojnë", text_color=color.gray)
