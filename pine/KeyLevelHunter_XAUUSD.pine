// Key Level Hunter XAUUSD
//
// Key levels as zones:
//   swing levels    = pivot highs / lows (liquidity), +-tolerance,
//   order blocks    = the last opposite candle before a break of the last
//                     swing high (bullish OB) or swing low (bearish OB),
//   previous day    = previous day's high / low.
// Entry: price comes back into a zone and the bar closes on the right side
// of it (BUY at support, SELL at resistance), optionally with a rejection
// candle. A sweep of the level that closes back inside counts too.
// SL beyond the zone plus a buffer; TP at the nearest opposite zone (next
// liquidity) at least minRR away, or a fixed R. A zone is removed when it
// is broken (close beyond it) or used for a trade. One open trade per
// direction. Optional trend filter: only trades in the direction of the
// 1H EMA (previous closed 1H bar) or of the last break of structure. SL is assumed first when SL and TP are hit in one bar.
// Server hours are MT5 server time (New York + 7h). Results ignore the
// spread. Use a 5m chart.
//@version=5
indicator("Key Level Hunter XAUUSD", shorttitle="KL Hunter", overlay=true, max_boxes_count=500, max_labels_count=500, max_bars_back=500)

// ===== Inputs =====
grpT    = "Koha (ora e serverit MT5 = New York + 7)"
firstH  = input.int(3,  "Asnjë hyrje para orës", minval=0, maxval=23, group=grpT)
lastH   = input.int(22, "Asnjë hyrje e re nga ora", minval=1, maxval=24, group=grpT)

grpL    = "Nivelet: key levels, likuiditet, OB"
pivLen  = input.int(12, "Swing: qirinj në secilën anë", minval=2, group=grpL)
tolPct  = input.float(0.03, "Gjerësia e nivelit (% e çmimit)", minval=0.0, step=0.01, group=grpL)
usePD   = input.bool(true, "Maksimumi / minimumi i ditës së kaluar", group=grpL)
useOB   = input.bool(true, "Order Block", group=grpL)
obBack  = input.int(10, "OB: kërko qiririn e kundërt deri në (qirinj)", minval=1, maxval=50, group=grpL)
minAge  = input.int(6, "Zona duhet të jetë e vjetër të paktën (qirinj)", minval=1, group=grpL)
maxZones = input.int(30, "Maksimumi i zonave për secilën anë", minval=5, group=grpL)
showZones = input.bool(true, "Vizato zonat", group=grpL)

grpE    = "Hyrja dhe dalja"
needCandle = input.bool(true, "Kërko qiri refuzimi (BUY jeshil / SELL i kuq)", group=grpE)
trendMode = input.string("EMA 1H", "Vetëm në drejtim të trendit", options=["Jo", "EMA 1H", "Struktura (BOS)"], group=grpE)
emaLen  = input.int(50, "EMA 1H: gjatësia", minval=5, group=grpE)
slBuf   = input.float(0.05, "SL përtej zonës (% e çmimit)", minval=0.0, step=0.01, group=grpE)
maxSL   = input.float(0.50, "Kalo nëse SL është më larg se (% e çmimit)", minval=0.05, step=0.05, group=grpE)
tpMode  = input.string("Likuiditeti i radhës", "TP", options=["Likuiditeti i radhës", "R"], group=grpE)
minRR   = input.float(2.0, "TP të paktën (R)", minval=0.5, step=0.5, group=grpE)
tpR     = input.float(3.0, "TP në R (kur TP = R)", minval=0.5, step=0.5, group=grpE)
trackH  = input.int(24, "Mbyll pas (orë)", minval=1, group=grpE)
showBox = input.bool(true, "Vizato trade-t", group=grpE)
riskPct = input.float(0.5, "Rreziku për trade (%) për tabelën", minval=0.1, step=0.1, group=grpE)

// ===== Types =====
type Zone
    int   dir        // +1 support (BUY), -1 resistance (SELL)
    int   kind       // 0 swing level, 1 order block, 2 previous day
    float top
    float bot
    int   born       // bar_index when the zone became known
    box   bx

type Trade
    int   dir
    int   t0
    int   endT
    float entry
    float sl
    float tp
    float risk
    box   rewardBox
    box   riskBox

type Stats
    int   n    = 0
    int   tp   = 0
    int   sl   = 0
    int   out  = 0
    int   win  = 0
    float sumR = 0.0

// ===== Functions =====
f_removeZone(array<Zone> zones, int i) =>
    Zone z = array.get(zones, i)
    if not na(z.bx)
        box.set_extend(z.bx, extend.none)
        box.set_right(z.bx, bar_index)
    array.remove(zones, i)
    true

f_addZone(array<Zone> zones, int dir, int kind, float top, float bot, int leftBar) =>
    bool dup = false
    int  cnt = 0
    int  oldest = -1
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.dir == dir
                cnt += 1
                if oldest < 0
                    oldest := i
                if z.kind == kind and top >= z.bot and bot <= z.top
                    dup := true
    if not dup
        box b = na
        if showZones
            color c = dir == 1 ? (kind == 1 ? color.new(color.blue, 88) : color.new(color.teal, 92)) : (kind == 1 ? color.new(color.orange, 88) : color.new(color.red, 92))
            b := box.new(leftBar, top, bar_index, bot, border_color=c, bgcolor=c, extend=extend.right)
        array.push(zones, Zone.new(dir, kind, top, bot, bar_index, b))
        if cnt >= maxZones and oldest >= 0              // keep at most maxZones per side
            Zone o = array.get(zones, oldest)
            if not na(o.bx)
                box.delete(o.bx)
            array.remove(zones, oldest)
    true

// Nearest opposite zone at least minDist away (the next liquidity)
f_target(array<Zone> zones, int dir, float entry, float minDist) =>
    float best = na
    for z in zones
        if z.dir == -dir
            float lvl  = dir == 1 ? z.bot : z.top
            float dist = dir * (lvl - entry)
            if dist >= minDist and (na(best) or dist < dir * (best - entry))
                best := lvl
    best

f_kindName(int kind, int dir) =>
    kind == 1 ? "OB" : kind == 2 ? (dir == 1 ? "PDL" : "PDH") : "Nivel"

// ===== State =====
var array<Zone>  zones  = array.new<Zone>()
var array<Trade> trades = array.new<Trade>()
var Stats        st     = Stats.new()
var float        lastPH = na
var float        lastPL = na
var bool         phUsed = true
var bool         plUsed = true
var int          structure = 0     // +1 after a bullish break of structure, -1 after a bearish one

[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
float ph       = ta.pivothigh(high, pivLen, pivLen)
float pl       = ta.pivotlow(low, pivLen, pivLen)
float tol      = close * tolPct / 100
int   srvHour  = (hour(time, "America/New_York") + 7) % 24
bool  inWindow = srvHour >= firstH and srvHour < lastH
bool  newDay   = timeframe.change("D")
float emaH     = request.security(syminfo.tickerid, "60", ta.ema(close, emaLen)[1], lookahead=barmerge.lookahead_on)
int   emaTrend = close > emaH ? 1 : -1

// ===== 1) follow the open trades =====
if array.size(trades) > 0
    for i = array.size(trades) - 1 to 0
        Trade t = array.get(trades, i)
        if time > t.t0
            bool  slHit = t.dir == 1 ? low <= t.sl : high >= t.sl
            bool  tpHit = t.dir == 1 ? high >= t.tp : low <= t.tp
            float res   = slHit ? -1.0 : tpHit ? t.dir * (t.tp - t.entry) / t.risk : time >= t.endT ? t.dir * (close - t.entry) / t.risk : na
            if showBox
                box.set_right(t.rewardBox, bar_index)
                box.set_right(t.riskBox, bar_index)
            if not na(res)
                st.sumR := st.sumR + res
                st.win  := st.win + (res > 0 ? 1 : 0)
                if slHit
                    st.sl := st.sl + 1
                else if tpHit
                    st.tp := st.tp + 1
                else
                    st.out := st.out + 1
                float exitPx = slHit ? t.sl : tpHit ? t.tp : close
                label.new(bar_index, exitPx, (res > 0 ? "✔ +" : "✖ ") + str.tostring(res, "0.0") + "R", style=label.style_label_left, color=res > 0 ? color.new(color.green, 0) : color.new(color.red, 0), textcolor=color.white, size=size.normal)
                array.remove(trades, i)

// ===== 2) new zones =====
if not na(pl)
    f_addZone(zones, 1, 0, pl + tol, pl - tol, bar_index - pivLen)
    lastPL := pl
    plUsed := false
if not na(ph)
    f_addZone(zones, -1, 0, ph + tol, ph - tol, bar_index - pivLen)
    lastPH := ph
    phUsed := false
if usePD and newDay
    f_addZone(zones, 1, 2, pdL + tol, pdL - tol, bar_index)
    f_addZone(zones, -1, 2, pdH + tol, pdH - tol, bar_index)
if not phUsed and not na(lastPH) and close > lastPH     // bullish break of structure
    phUsed    := true
    structure := 1
    if useOB
        for i = 1 to obBack
            if close[i] < open[i]
                f_addZone(zones, 1, 1, high[i], low[i], bar_index - i)
                break
if not plUsed and not na(lastPL) and close < lastPL     // bearish break of structure
    plUsed    := true
    structure := -1
    if useOB
        for i = 1 to obBack
            if close[i] > open[i]
                f_addZone(zones, -1, 1, high[i], low[i], bar_index - i)
                break

// ===== 3) entries at the zones =====
bool longOpen  = false
bool shortOpen = false
for tr in trades
    if tr.dir == 1
        longOpen := true
    else
        shortOpen := true

if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        bool broken  = z.dir == 1 ? close < z.bot : close > z.top
        bool touched = z.dir == 1 ? low <= z.top : high >= z.bot
        if broken
            f_removeZone(zones, i)
        else if touched and bar_index - z.born >= minAge and inWindow
            bool candleOk = not needCandle or (z.dir == 1 ? close > open : close < open)
            bool sideFree = z.dir == 1 ? not longOpen : not shortOpen
            bool trendOk  = trendMode == "Jo" or (trendMode == "EMA 1H" ? z.dir == emaTrend : z.dir == structure)
            if candleOk and sideFree and trendOk
                float sl   = z.dir == 1 ? math.min(z.bot, low) - close * slBuf / 100 : math.max(z.top, high) + close * slBuf / 100
                float risk = z.dir * (close - sl)
                float tp   = tpMode == "R" ? close + z.dir * tpR * risk : f_target(zones, z.dir, close, minRR * risk)
                if risk > 0 and risk / close * 100 <= maxSL and not na(tp)
                    Trade nt = Trade.new(z.dir, time, time + trackH * 3600000, close, sl, tp, risk)
                    if showBox
                        nt.rewardBox := box.new(bar_index, math.max(close, tp), bar_index + 1, math.min(close, tp), border_color=color.new(color.teal, 60), bgcolor=color.new(color.teal, 80))
                        nt.riskBox   := box.new(bar_index, math.max(close, sl), bar_index + 1, math.min(close, sl), border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 80))
                    string txt = (z.dir == 1 ? "BUY " : "SELL ") + f_kindName(z.kind, z.dir)
                    label.new(bar_index, z.dir == 1 ? low : high, txt, style=z.dir == 1 ? label.style_label_up : label.style_label_down, color=z.dir == 1 ? color.teal : color.red, textcolor=color.white, size=size.small)
                    array.push(trades, nt)
                    st.n := st.n + 1
                    if z.dir == 1
                        longOpen := true
                    else
                        shortOpen := true
                    f_removeZone(zones, i)                // a zone is traded once

// ===== Results table =====
var table tb = table.new(position.top_right, 2, 9, bgcolor=color.rgb(20, 20, 20), border_width=1)
if barstate.islast
    int closed = st.tp + st.sl + st.out
    table.cell(tb, 0, 0, "Key Level Hunter", text_color=color.white)
    table.cell(tb, 1, 0, timeframe.in_seconds() > 900 ? "Përdor 5m!" : "", text_color=color.orange)
    table.cell(tb, 0, 1, "Trade", text_color=color.white)
    table.cell(tb, 1, 1, str.tostring(st.n), text_color=color.white)
    table.cell(tb, 0, 2, "Arritën TP", text_color=color.white)
    table.cell(tb, 1, 2, str.tostring(st.tp), text_color=color.lime)
    table.cell(tb, 0, 3, "Prekën SL", text_color=color.white)
    table.cell(tb, 1, 3, str.tostring(st.sl), text_color=color.rgb(255, 90, 90))
    table.cell(tb, 0, 4, "Mbyllur nga koha", text_color=color.white)
    table.cell(tb, 1, 4, str.tostring(st.out), text_color=color.white)
    table.cell(tb, 0, 5, "Fitojnë", text_color=color.white)
    table.cell(tb, 1, 5, closed > 0 ? str.tostring(100.0 * st.win / closed, "0") + "%" : "-", text_color=color.white)
    table.cell(tb, 0, 6, "Gjithsej R", text_color=color.white)
    table.cell(tb, 1, 6, (st.sumR > 0 ? "+" : "") + str.tostring(st.sumR, "0.0"), text_color=st.sumR >= 0 ? color.lime : color.rgb(255, 90, 90))
    table.cell(tb, 0, 7, "Mesatarja R / trade", text_color=color.white)
    table.cell(tb, 1, 7, closed > 0 ? str.tostring(st.sumR / closed, "0.00") : "-", text_color=color.white)
    table.cell(tb, 0, 8, "Llogaria me " + str.tostring(riskPct, "0.0#") + "% rrezik", text_color=color.white)
    table.cell(tb, 1, 8, (st.sumR > 0 ? "+" : "") + str.tostring(st.sumR * riskPct, "0.0") + "%", text_color=st.sumR >= 0 ? color.lime : color.rgb(255, 90, 90))
