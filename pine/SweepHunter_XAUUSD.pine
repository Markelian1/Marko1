// Sweep Hunter XAUUSD -- TradingView version of XAUUSD_SweepScanner.mq5
//
// Each day (the chart's daily session) the day's low and high are tracked.
// A sweep is a move beyond a level that has stood at least "minAge"
// minutes, followed by a close back inside within "reclaim" minutes:
//   sweep of the low  -> BUY at that close, SL at the sweep low,
//   sweep of the high -> SELL at that close, SL at the sweep high.
// One signal per side per day. Each trade is followed until TP, SL or
// "trackH" hours; SL is assumed first when both are hit in one bar.
// Server hours are MT5 server time (New York + 7h). Results ignore the
// spread. Use a 1m or 5m chart.
//@version=5
indicator("Sweep Hunter XAUUSD", shorttitle="Sweep Hunter", overlay=true, max_boxes_count=500, max_labels_count=500)

// ===== Inputs =====
grpT    = "Koha (ora e serverit MT5 = New York + 7)"
firstH  = input.int(3,  "Asnjë sinjal para orës", minval=0, maxval=23, group=grpT)
lastH   = input.int(22, "Asnjë sinjal i ri nga ora", minval=1, maxval=24, group=grpT)
grpS    = "Sinjali"
minAge  = input.int(60, "Niveli duhet të ketë qëndruar (minuta)", minval=1, group=grpS)
reclaim = input.int(15, "Çmimi kthehet brenda për (minuta)", minval=1, group=grpS)
minStop = input.float(0.10, "Kalo stop-et nën këtë % të çmimit", minval=0.0, step=0.01, group=grpS)
grpE    = "Dalja"
tpMode  = input.string("R", "TP", options=["R", "Ana tjetër e ditës", "Dita e kaluar"], group=grpE)
tpR     = input.float(3.0, "TP në R (kur TP = R)", minval=0.5, step=0.5, group=grpE)
trackH  = input.int(24, "Mbyll pas (orë)", minval=1, group=grpE)
showBox = input.bool(true, "Vizato trade-t", group=grpE)

// ===== Types =====
type Side
    int   dir        // +1 sweep of the low -> BUY, -1 sweep of the high -> SELL
    float level      // day low / day high so far
    int   levelT     // when that level was made
    bool  broken     // closed beyond an old level, waiting for the reclaim
    int   breakT
    float brokenLvl
    float ext        // extreme since the break
    bool  done       // one signal per side per day

type Trade
    int   dir
    int   t0
    int   endT
    float entry
    float sl
    float tp
    float risk
    box   rewardBox
    box   riskBox

type Stats
    int   n    = 0
    int   tp   = 0
    int   sl   = 0
    int   out  = 0
    int   win  = 0
    float sumR = 0.0

// ===== Functions =====
f_reset(Side s) =>
    s.level     := s.dir == 1 ? low : high
    s.levelT    := time
    s.broken    := false
    s.breakT    := na
    s.brokenLvl := na
    s.ext       := na
    s.done      := false
    true

// Advance one side by one bar; returns [signal, stop level]
f_process(Side s, bool inWindow) =>
    float beyond = s.dir == 1 ? low : high
    bool  isNew  = s.dir == 1 ? beyond < s.level : beyond > s.level
    bool  fire   = false
    float slv    = na
    if s.broken
        if s.dir == 1 ? low < s.ext : high > s.ext
            s.ext := beyond
        bool back = s.dir == 1 ? close > s.brokenLvl : close < s.brokenLvl
        if back and time - s.breakT <= reclaim * 60000
            if not s.done and inWindow
                fire := true
                slv  := s.ext
            s.done   := true
            s.broken := false
        else if time - s.breakT > reclaim * 60000
            s.broken := false                      // accepted break, no signal
    else if isNew and not s.done and inWindow and time - s.levelT >= minAge * 60000
        s.brokenLvl := s.level
        bool backNow = s.dir == 1 ? close > s.level : close < s.level
        if backNow                                 // swept and reclaimed in one bar
            fire   := true
            slv    := beyond
            s.done := true
        else
            s.broken := true
            s.breakT := time
            s.ext    := beyond
    if isNew
        s.level  := beyond
        s.levelT := time
    [fire, slv]

f_open(array<Trade> trades, Stats st, int dir, float sl, float otherSide, float pdH, float pdL) =>
    float risk = dir == 1 ? close - sl : sl - close
    if risk > 0 and risk / close * 100 >= minStop
        float tp = tpMode == "R" ? close + dir * tpR * risk : tpMode == "Ana tjetër e ditës" ? otherSide : (dir == 1 ? pdH : pdL)
        if not na(tp) and dir * (tp - close) > 0
            Trade t = Trade.new(dir, time, time + trackH * 3600000, close, sl, tp, risk)
            if showBox
                t.rewardBox := box.new(bar_index, math.max(close, tp), bar_index + 1, math.min(close, tp), border_color=color.new(color.teal, 60), bgcolor=color.new(color.teal, 80))
                t.riskBox   := box.new(bar_index, math.max(close, sl), bar_index + 1, math.min(close, sl), border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 80))
            label.new(bar_index, dir == 1 ? low : high, dir == 1 ? "BUY" : "SELL", style=dir == 1 ? label.style_label_up : label.style_label_down, color=dir == 1 ? color.teal : color.red, textcolor=color.white, size=size.small)
            array.push(trades, t)
            st.n := st.n + 1
    true

// ===== State =====
var Side         sLo    = Side.new(1)
var Side         sHi    = Side.new(-1)
var array<Trade> trades = array.new<Trade>()
var Stats        st     = Stats.new()

[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
int  srvHour  = (hour(time, "America/New_York") + 7) % 24
bool inWindow = srvHour >= firstH and srvHour < lastH
bool newDay   = timeframe.change("D")

// ===== 1) follow the open trades =====
if array.size(trades) > 0
    for i = array.size(trades) - 1 to 0
        Trade t = array.get(trades, i)
        if time > t.t0
            bool  slHit = t.dir == 1 ? low <= t.sl : high >= t.sl
            bool  tpHit = t.dir == 1 ? high >= t.tp : low <= t.tp
            float res   = slHit ? -1.0 : tpHit ? t.dir * (t.tp - t.entry) / t.risk : time >= t.endT ? t.dir * (close - t.entry) / t.risk : na
            if showBox
                box.set_right(t.rewardBox, bar_index)
                box.set_right(t.riskBox, bar_index)
            if not na(res)
                st.sumR := st.sumR + res
                st.win  := st.win + (res > 0 ? 1 : 0)
                if slHit
                    st.sl := st.sl + 1
                else if tpHit
                    st.tp := st.tp + 1
                else
                    st.out := st.out + 1
                label.new(bar_index, t.dir == 1 ? high : low, (res > 0 ? "+" : "") + str.tostring(res, "0.0") + "R", style=label.style_none, textcolor=res > 0 ? color.teal : color.red, size=size.small)
                array.remove(trades, i)

// ===== 2) day levels and new signals =====
if newDay or na(sLo.level)
    f_reset(sLo)
    f_reset(sHi)
else
    float dayLow  = sLo.level                  // the day's range before this bar
    float dayHigh = sHi.level
    [fireL, slL] = f_process(sLo, inWindow)
    [fireS, slS] = f_process(sHi, inWindow)
    if fireL
        f_open(trades, st, 1, slL, dayHigh, pdH, pdL)
    if fireS
        f_open(trades, st, -1, slS, dayLow, pdH, pdL)

plot(sLo.level, "Minimumi i ditës", color=color.new(color.teal, 40), style=plot.style_linebr)
plot(sHi.level, "Maksimumi i ditës", color=color.new(color.red, 40), style=plot.style_linebr)

// ===== Results table =====
var table tb = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 15), border_width=1)
if barstate.islast
    int closed = st.tp + st.sl + st.out
    table.cell(tb, 0, 0, "Sweep Hunter", text_color=color.white)
    table.cell(tb, 1, 0, timeframe.in_seconds() > 900 ? "Përdor 1m ose 5m!" : "", text_color=color.orange)
    table.cell(tb, 0, 1, "Sinjale", text_color=color.white)
    table.cell(tb, 1, 1, str.tostring(st.n), text_color=color.white)
    table.cell(tb, 0, 2, "Arritën TP", text_color=color.white)
    table.cell(tb, 1, 2, str.tostring(st.tp), text_color=color.teal)
    table.cell(tb, 0, 3, "Preknë SL", text_color=color.white)
    table.cell(tb, 1, 3, str.tostring(st.sl), text_color=color.red)
    table.cell(tb, 0, 4, "Mbyllur nga koha", text_color=color.white)
    table.cell(tb, 1, 4, str.tostring(st.out), text_color=color.white)
    table.cell(tb, 0, 5, "Fitojnë", text_color=color.white)
    table.cell(tb, 1, 5, closed > 0 ? str.tostring(100.0 * st.win / closed, "0") + "%" : "-", text_color=color.white)
    table.cell(tb, 0, 6, "Gjithsej R", text_color=color.white)
    table.cell(tb, 1, 6, (st.sumR > 0 ? "+" : "") + str.tostring(st.sumR, "0.0"), text_color=st.sumR >= 0 ? color.teal : color.red)
    table.cell(tb, 0, 7, "Mesatarja R / trade", text_color=color.white)
    table.cell(tb, 1, 7, closed > 0 ? str.tostring(st.sumR / closed, "0.00") : "-", text_color=color.white)
